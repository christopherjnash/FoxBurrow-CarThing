[Unit]
Description=WallThing Kiosk
Wants=network-online.target
After=network-online.target usbgadget.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/python3 /scripts/kiosk.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
